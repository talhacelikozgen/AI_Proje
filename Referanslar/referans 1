<!-- Strength Ayarı -->
<div class="space-y-2 mt-4">
    <div class="flex justify-between text-xs font-bold text-slate-400 uppercase tracking-widest">
        <span>Değişim Gücü (Strength)</span>
        <span id="strengthVal" class="text-purple-400">0.50</span>
    </div>
    <input type="range" id="strengthRange" min="0.1" max="1.0" step="0.05" value="0.5" 
        class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-purple-500"
        oninput="document.getElementById('strengthVal').innerText = this.value">
    <p class="text-[10px] text-slate-500 italic">Düşük: Orijinale sadık | Yüksek: Tamamen yeni tasarım</p>
</div>

<!-- Görsel Yükleme Alanı -->
<div class="mt-4">
    <input type="file" id="imageInput" accept="image/*" class="hidden">
    <button onclick="document.getElementById('imageInput').click()" 
        class="w-full bg-slate-800 border border-slate-700 py-3 rounded-2xl text-sm font-medium hover:bg-slate-700 transition-all">
        REFERANS GÖRSEL SEÇ (Opsiyonel)
    </button>
    <div id="fileName" class="text-[10px] text-emerald-400 mt-1 text-center"></div>
</div>